---
import { SITE_TITLE } from '../../consts';
import Page from '../../layouts/Page.astro';
import { getTags } from '../../lib/posts';

const tags = await getTags();
---

<Page title="Tags" description={`Browse posts from ${SITE_TITLE} by topic.`}>
	<h1>Tags</h1>
	{tags.size === 0 && <p class="muted">No tags yet.</p>}
	<ul class="tag-list tags">
		{[...tags].map(([slug, { name, posts }]) => (
			<li>
				<a href={`/tags/${slug}/`}>
					{name} <span class="count">{posts.length}</span>
				</a>
			</li>
		))}
	</ul>
</Page>

<style>
	.tags a {
		font-size: 0.95em;
		padding: 0.2em 0.8em;
	}
	.count {
		opacity: 0.7;
		margin-left: 0.2em;
	}
</style>
