{
  "trailingSlash": "auto",
  "responseOverrides": {
    "404": {
      "rewrite": "/404.html",
      "statusCode": 404
    }
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "X-Frame-Options": "SAMEORIGIN"
  },
  "routes": [
    {
      "route": "/_astro/*",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "route": "/feeds/posts/default",
      "redirect": "/rss.xml",
      "statusCode": 301
    },
    {
      "route": "/search/label/*",
      "redirect": "/tags/",
      "statusCode": 301
    },
    {
      "route": "/search",
      "redirect": "/blog/",
      "statusCode": 301
    }
  ]
}
